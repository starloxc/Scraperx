{
  "name": "secret-cipher",
  "version": "0.1.2",
  "private": false,
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "prettier": "prettier --write .",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "release": "pnpm build && pnpm publish --access public --no-git-checks"
  },
  "prettier": "@unix/prettier",
  "devDependencies": {
    "@types/node": "^24.12.4",
    "@unix/eslint": "^1.3.0",
    "@unix/prettier": "^0.1.0",
    "eslint": "^10.8.0",
    "prettier": "^3.8.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
