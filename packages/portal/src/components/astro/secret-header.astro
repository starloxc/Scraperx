---
import anonymousIcon from '@/assets/icons/logo-solid.svg?raw'
import { SecretMenu } from '@/components/secret-menu'

interface Props {
  compact?: boolean
  showBrandText?: boolean
}

const { compact = false, showBrandText = true } = Astro.props
const currentPath = Astro.url.pathname

const navItems = [
  { label: 'Create', href: '/go' },
  { label: 'Playground', href: '/api/playground' },
  { label: 'Keys', href: '/api/keys' },
  { label: 'Quotas', href: '/api/quotas' },
  { label: 'Docs', href: '/api/docs' },
  { label: 'Track', href: '/track' },
  { label: 'Terminal', href: '/terminal' },
]
---

<nav
  aria-label="Primary"
  class:list={[
    'mx-auto flex w-full max-w-7xl items-center justify-between px-4 md:px-10',
    compact ? 'h-16' : 'h-20',
  ]}>
  {/* Zone 1: Single text element / brand wordmark */}
  <div class="flex items-center gap-3">
    <a
      href="/"
      draggable="false"
      aria-label="Secret home"
      class="flex h-9 items-center gap-2 rounded-lg border border-dashed border-zinc-300 bg-white px-2 pr-3 text-sm font-medium text-zinc-800 shadow-2xs transition-colors hover:border-violet-400 hover:text-zinc-950">
      <span
        class="flex size-7 items-center justify-center rounded-md bg-zinc-100 text-zinc-950 [&_svg]:size-4.5">
        <Fragment set:html={anonymousIcon} />
      </span>
      {showBrandText && <span class="font-semibold tracking-tight">Secret</span>}
    </a>
  </div>

  {/* Zone 2: Clean single-line text navigation links */}
  <div
    class="hidden items-center gap-1 rounded-full border border-zinc-200 bg-zinc-50/80 px-2 py-1 shadow-2xs md:flex">
    {
      navItems.map(item => {
        const isActive =
          item.href === '/' ? currentPath === '/' : currentPath.startsWith(item.href)
        return (
          <a
            href={item.href}
            class:list={[
              'relative inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 text-xs font-medium whitespace-nowrap transition-colors',
              isActive
                ? 'bg-zinc-900 text-white shadow-xs'
                : 'text-zinc-600 hover:bg-zinc-200/60 hover:text-zinc-950',
            ]}>
            <span>{item.label}</span>
          </a>
        )
      })
    }
  </div>

  {/* Zone 3: 1 primary action & menu trigger */}
  <div class="flex items-center gap-2">
    <a
      href="/api/playground"
      class="hidden h-9 items-center justify-center rounded-lg bg-zinc-900 px-3.5 text-xs font-medium whitespace-nowrap text-white shadow-2xs transition-colors hover:bg-zinc-800 lg:inline-flex">
      API Playground
    </a>
    <SecretMenu client:load currentPath={currentPath} />
  </div>
</nav>
